        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay/>
      <!-- Appearance only: dynamics, sensors and collisions remain the PX4 x500 baseline. -->
      <visual name="amov_p450_v3_body_visual">
        <!-- PX4's spawn request overrides the model-level pose; align CAD skids to the settled x500 collision feet. -->
        <!-- GLB is Y-up; rotate it into Gazebo's Z-up frame. -->
        <pose>0 0 -0.22 1.570796327 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://p450_v2/meshes/amov_p450_gazebo_body.glb</uri>
          </mesh>
        </geometry>
      </visual>
