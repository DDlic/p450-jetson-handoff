diff --git a/include/uxr/agent/diagnostics/P450Trace.hpp b/include/uxr/agent/diagnostics/P450Trace.hpp
new file mode 100644
index 0000000..640c5ad
--- /dev/null
+++ b/include/uxr/agent/diagnostics/P450Trace.hpp
@@ -0,0 +1,97 @@
+// P450 software-only XRCE Agent timing trace.
+// This file is intentionally isolated from the normal Agent build tree.
+
+#ifndef UXR_AGENT_DIAGNOSTICS_P450_TRACE_HPP_
+#define UXR_AGENT_DIAGNOSTICS_P450_TRACE_HPP_
+
+#include <cstddef>
+#include <cstdint>
+#include <sys/types.h>
+
+namespace eprosima {
+namespace uxr {
+namespace p450_trace {
+
+enum class Event : uint16_t
+{
+    DDS_CALLBACK_BEGIN = 1,
+    DDS_CALLBACK_END = 2,
+    SEQ_ASSIGNED = 3,
+    QUEUE_NEW = 4,
+    SEND_BEGIN = 5,
+    UART_WRITE_BEGIN = 6,
+    UART_WRITE_END = 7,
+    SEND_END = 8,
+    ACKNACK_RX = 9,
+    RETX_QUEUE = 10,
+    ACK_UPDATE = 11,
+    HEARTBEAT_QUEUE = 12
+};
+
+void callback_begin(
+        uint8_t session_id,
+        uint8_t stream_id,
+        uint16_t object_id,
+        uint32_t client_key,
+        size_t len);
+
+void callback_end(bool result);
+
+void sequence_assigned(
+        uint8_t stream_id,
+        uint16_t seq_num,
+        size_t len);
+
+void queue_new(
+        uint8_t stream_id,
+        uint16_t seq_num,
+        size_t len);
+
+void acknack_received(
+        uint8_t session_id,
+        uint8_t stream_id,
+        uint16_t first_unacked,
+        uint16_t nack_bitmap,
+        uint32_t client_key);
+
+void retransmit_queued(
+        uint8_t session_id,
+        uint8_t stream_id,
+        uint16_t seq_num,
+        uint16_t first_unacked,
+        uint16_t nack_bitmap,
+        uint32_t client_key,
+        size_t len);
+
+void ack_updated(
+        uint8_t session_id,
+        uint8_t stream_id,
+        uint16_t first_unacked,
+        uint16_t nack_bitmap,
+        uint32_t client_key);
+
+void heartbeat_queued(
+        uint8_t session_id,
+        uint8_t stream_id,
+        uint16_t first_unacked,
+        uint16_t last_unacked,
+        uint32_t client_key);
+
+void send_begin(
+        uint8_t session_id,
+        uint8_t stream_id,
+        uint16_t seq_num,
+        uint32_t client_key,
+        size_t len);
+
+void send_end(bool result);
+
+void uart_write_begin(size_t len);
+
+void uart_write_end(ssize_t result);
+
+} // namespace p450_trace
+} // namespace uxr
+} // namespace eprosima
+
+#endif // UXR_AGENT_DIAGNOSTICS_P450_TRACE_HPP_
