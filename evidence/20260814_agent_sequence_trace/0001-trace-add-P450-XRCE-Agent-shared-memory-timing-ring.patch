@@ -20,6 +20,7 @@
 #include <uxr/agent/Root.hpp>
 #include <uxr/agent/transport/Server.hpp>
 #include <uxr/agent/utils/Time.hpp>
+#include <uxr/agent/diagnostics/P450Trace.hpp>
 
