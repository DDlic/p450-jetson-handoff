 #include <uxr/agent/transport/endpoint/IPv6EndPoint.hpp>
@@ -618,6 +619,11 @@ bool Processor<EndPoint>::process_acknack_submessage(
         uint16_t first_message = acknack_payload.first_unacked_seq_num();
