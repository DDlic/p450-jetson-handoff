@@ -86,6 +101,10 @@ private:
     size_t len_;
     fastcdr::FastBuffer fastbuffer_;
     fastcdr::Cdr serializer_;
+    uint8_t session_id_;
+    uint8_t stream_id_;
+    uint16_t sequence_nr_;
+    uint32_t client_key_raw_;
 };
 
