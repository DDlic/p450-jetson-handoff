diff --git a/src/cpp/diagnostics/P450Trace.cpp b/src/cpp/diagnostics/P450Trace.cpp
new file mode 100644
index 0000000..bae9097
--- /dev/null
+++ b/src/cpp/diagnostics/P450Trace.cpp
@@ -0,0 +1,342 @@
+#include <uxr/agent/diagnostics/P450Trace.hpp>
+
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <mutex>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+
+namespace eprosima {
+namespace uxr {
+namespace p450_trace {
+
+namespace {
+
+constexpr uint64_t TRACE_MAGIC = UINT64_C(0x4543525830353450); // "P450XRCE" little-endian.
+constexpr uint32_t TRACE_VERSION = 1;
+constexpr uint32_t TRACE_CAPACITY = 32768;
+constexpr uint16_t NO_SEQUENCE = UINT16_MAX;
+
+struct alignas(8) TraceHeader
+{
+    uint64_t magic;
+    uint32_t version;
+    uint32_t header_size;
+    uint32_t record_size;
+    uint32_t capacity;
+    uint64_t start_ns;
+    uint64_t write_index;
+    uint32_t pid;
+    uint32_t stream_filter;
+    uint64_t reserved[2];
+};
+
+struct alignas(8) TraceRecord
+{
+    uint64_t commit;
+    uint64_t t_ns;
+    uint64_t aux;
+    uint32_t callback_id;
+    uint32_t client_key;
+    uint32_t tid;
+    uint32_t len;
+    int32_t result;
+    uint16_t event;
+    uint16_t seq_num;
+    uint16_t first_unacked;
+    uint16_t nack_bitmap;
+    uint16_t object_id;
+    uint8_t session_id;
+    uint8_t stream_id;
+    uint32_t reserved[2];
+};
+
+static_assert(sizeof(TraceHeader) == 64, "P450 trace header layout changed");
+static_assert(sizeof(TraceRecord) == 64, "P450 trace record layout changed");
+
+struct TraceMap
+{
+    TraceHeader header;
+    TraceRecord records[TRACE_CAPACITY];
+};
+
+struct ThreadContext
+{
+    uint32_t callback_id = 0;
+    uint32_t client_key = 0;
+    uint16_t object_id = 0;
+    uint16_t send_seq = NO_SEQUENCE;
+    uint8_t session_id = 0;
+    uint8_t stream_id = 0;
+    bool callback_active = false;
+    bool send_active = false;
+};
+
+TraceMap* trace_map = nullptr;
+std::once_flag init_once;
+std::atomic<uint32_t> callback_counter{0};
+thread_local ThreadContext thread_context;
+
+uint64_t monotonic_raw_ns()
+{
+    struct timespec ts = {};
+    clock_gettime(CLOCK_MONOTONIC_RAW, &ts);
+    return uint64_t(ts.tv_sec) * UINT64_C(1000000000) + uint64_t(ts.tv_nsec);
+}
+
+uint32_t current_tid()
+{
+    return static_cast<uint32_t>(syscall(SYS_gettid));
+}
+
+void initialize()
+{
+    const char* path = std::getenv("P450_XRCE_TRACE_FILE");
+    if (nullptr == path || '\0' == path[0])
+    {
+        return;
+    }
+
+    uint32_t stream_filter = 128;
+    const char* stream_value = std::getenv("P450_XRCE_TRACE_STREAM");
+    if (nullptr != stream_value && '\0' != stream_value[0])
+    {
+        char* end = nullptr;
+        const unsigned long parsed = std::strtoul(stream_value, &end, 0);
+        if (end != stream_value && '\0' == *end && parsed <= UINT8_MAX)
+        {
+            stream_filter = static_cast<uint32_t>(parsed);
+        }
+    }
+
+    const int fd = ::open(path, O_RDWR | O_CREAT | O_TRUNC, S_IRUSR | S_IWUSR | S_IRGRP);
+    if (fd < 0)
+    {
+        return;
+    }
+
+    const size_t map_size = sizeof(TraceMap);
+    if (0 != ftruncate(fd, static_cast<off_t>(map_size)))
+    {
+        ::close(fd);
+        return;
+    }
+
+    void* mapped = mmap(nullptr, map_size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    ::close(fd);
+    if (MAP_FAILED == mapped)
+    {
+        return;
+    }
+
+    trace_map = static_cast<TraceMap*>(mapped);
+    std::memset(trace_map, 0, map_size);
+    trace_map->header.version = TRACE_VERSION;
+    trace_map->header.header_size = sizeof(TraceHeader);
+    trace_map->header.record_size = sizeof(TraceRecord);
+    trace_map->header.capacity = TRACE_CAPACITY;
+    trace_map->header.start_ns = monotonic_raw_ns();
+    trace_map->header.pid = static_cast<uint32_t>(getpid());
+    trace_map->header.stream_filter = stream_filter;
+    __atomic_store_n(&trace_map->header.magic, TRACE_MAGIC, __ATOMIC_RELEASE);
+}
+
+bool accepts(uint8_t stream_id)
+{
+    std::call_once(init_once, initialize);
+    return nullptr != trace_map && trace_map->header.stream_filter == stream_id;
+}
+
+void record(
+        Event event,
+        uint8_t session_id,
+        uint8_t stream_id,
+        uint16_t seq_num,
+        uint16_t first_unacked,
+        uint16_t nack_bitmap,
+        uint16_t object_id,
+        uint32_t client_key,
+        int32_t result,
+        uint32_t len,
+        uint32_t callback_id,
+        uint64_t aux = 0)
+{
+    if (!accepts(stream_id))
+    {
+        return;
+    }
+
+    const uint64_t index = __atomic_fetch_add(&trace_map->header.write_index, UINT64_C(1), __ATOMIC_RELAXED);
+    TraceRecord& slot = trace_map->records[index % TRACE_CAPACITY];
+    __atomic_store_n(&slot.commit, UINT64_C(0), __ATOMIC_RELAXED);
+    slot.t_ns = monotonic_raw_ns();
+    slot.aux = aux;
+    slot.callback_id = callback_id;
+    slot.client_key = client_key;
+    slot.tid = current_tid();
+    slot.len = len;
+    slot.result = result;
+    slot.event = static_cast<uint16_t>(event);
+    slot.seq_num = seq_num;
+    slot.first_unacked = first_unacked;
+    slot.nack_bitmap = nack_bitmap;
+    slot.object_id = object_id;
+    slot.session_id = session_id;
+    slot.stream_id = stream_id;
+    slot.reserved[0] = 0;
+    slot.reserved[1] = 0;
+    __atomic_store_n(&slot.commit, index + UINT64_C(1), __ATOMIC_RELEASE);
+}
+
+} // namespace
+
+void callback_begin(
+        uint8_t session_id,
+        uint8_t stream_id,
+        uint16_t object_id,
+        uint32_t client_key,
+        size_t len)
+{
+    thread_context.callback_id = callback_counter.fetch_add(1, std::memory_order_relaxed) + 1;
+    thread_context.client_key = client_key;
+    thread_context.object_id = object_id;
+    thread_context.session_id = session_id;
+    thread_context.stream_id = stream_id;
+    thread_context.callback_active = true;
+    record(Event::DDS_CALLBACK_BEGIN, session_id, stream_id, NO_SEQUENCE, 0, 0, object_id,
+            client_key, 0, static_cast<uint32_t>(len), thread_context.callback_id);
+}
+
+void callback_end(bool result)
+{
+    if (thread_context.callback_active)
+    {
+        record(Event::DDS_CALLBACK_END, thread_context.session_id, thread_context.stream_id, NO_SEQUENCE,
+                0, 0, thread_context.object_id, thread_context.client_key, result ? 1 : 0, 0,
+                thread_context.callback_id);
+    }
+    thread_context.callback_active = false;
+}
+
+void sequence_assigned(uint8_t stream_id, uint16_t seq_num, size_t len)
+{
+    const uint32_t callback_id = thread_context.callback_active ? thread_context.callback_id : 0;
+    const uint16_t object_id = thread_context.callback_active ? thread_context.object_id : 0;
+    const uint32_t client_key = thread_context.callback_active ? thread_context.client_key : 0;
+    const uint8_t session_id = thread_context.callback_active ? thread_context.session_id : 0;
+    record(Event::SEQ_ASSIGNED, session_id, stream_id, seq_num, 0, 0,
+            object_id, client_key, 1, static_cast<uint32_t>(len), callback_id);
+}
+
+void queue_new(uint8_t stream_id, uint16_t seq_num, size_t len)
+{
+    const uint32_t callback_id = thread_context.callback_active ? thread_context.callback_id : 0;
+    const uint16_t object_id = thread_context.callback_active ? thread_context.object_id : 0;
+    const uint32_t client_key = thread_context.callback_active ? thread_context.client_key : 0;
+    const uint8_t session_id = thread_context.callback_active ? thread_context.session_id : 0;
+    record(Event::QUEUE_NEW, session_id, stream_id, seq_num, 0, 0,
+            object_id, client_key, 1, static_cast<uint32_t>(len), callback_id);
+}
+
+void acknack_received(
+        uint8_t session_id,
+        uint8_t stream_id,
+        uint16_t first_unacked,
+        uint16_t nack_bitmap,
+        uint32_t client_key)
+{
+    record(Event::ACKNACK_RX, session_id, stream_id, NO_SEQUENCE, first_unacked, nack_bitmap,
+            0, client_key, 1, 0, 0);
+}
+
+void retransmit_queued(
+        uint8_t session_id,
+        uint8_t stream_id,
+        uint16_t seq_num,
+        uint16_t first_unacked,
+        uint16_t nack_bitmap,
+        uint32_t client_key,
+        size_t len)
+{
+    record(Event::RETX_QUEUE, session_id, stream_id, seq_num, first_unacked, nack_bitmap,
+            0, client_key, 1, static_cast<uint32_t>(len), 0);
+}
+
+void ack_updated(
+        uint8_t session_id,
+        uint8_t stream_id,
+        uint16_t first_unacked,
+        uint16_t nack_bitmap,
+        uint32_t client_key)
+{
+    record(Event::ACK_UPDATE, session_id, stream_id, NO_SEQUENCE, first_unacked, nack_bitmap,
+            0, client_key, 1, 0, 0);
+}
+
+void heartbeat_queued(
+        uint8_t session_id,
+        uint8_t stream_id,
+        uint16_t first_unacked,
+        uint16_t last_unacked,
+        uint32_t client_key)
+{
+    record(Event::HEARTBEAT_QUEUE, session_id, stream_id, last_unacked, first_unacked, 0,
+            0, client_key, 1, 0, 0);
+}
+
+void send_begin(
+        uint8_t session_id,
+        uint8_t stream_id,
+        uint16_t seq_num,
+        uint32_t client_key,
+        size_t len)
+{
+    thread_context.session_id = session_id;
+    thread_context.stream_id = stream_id;
+    thread_context.send_seq = seq_num;
+    thread_context.client_key = client_key;
+    thread_context.send_active = true;
+    record(Event::SEND_BEGIN, session_id, stream_id, seq_num, 0, 0, 0, client_key,
+            0, static_cast<uint32_t>(len), 0);
+}
+
+void send_end(bool result)
+{
+    if (thread_context.send_active)
+    {
+        record(Event::SEND_END, thread_context.session_id, thread_context.stream_id,
+                thread_context.send_seq, 0, 0, 0, thread_context.client_key, result ? 1 : 0, 0, 0);
+    }
+    thread_context.send_active = false;
+}
+
+void uart_write_begin(size_t len)
+{
+    if (thread_context.send_active)
+    {
+        record(Event::UART_WRITE_BEGIN, thread_context.session_id, thread_context.stream_id,
+                thread_context.send_seq, 0, 0, 0, thread_context.client_key, 0,
+                static_cast<uint32_t>(len), 0);
+    }
+}
+
+void uart_write_end(ssize_t result)
+{
+    if (thread_context.send_active)
+    {
+        record(Event::UART_WRITE_END, thread_context.session_id, thread_context.stream_id,
+                thread_context.send_seq, 0, 0, 0, thread_context.client_key,
+                static_cast<int32_t>(result), 0, 0);
+    }
+}
+
+} // namespace p450_trace
+} // namespace uxr
+} // namespace eprosima
