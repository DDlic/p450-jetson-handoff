From e6f3d83ff5004c2fd634f12b3c4bfb2983a1c157 Mon Sep 17 00:00:00 2001
From: DDlic <DDlic@users.noreply.github.com>
Date: Thu, 13 Aug 2026 16:10:24 +0800
Subject: [PATCH] uxrce_dds_client: make offboard heartbeat reliable

---
 src/modules/uxrce_dds_client/dds_topics.h.em        | 2 +-
 src/modules/uxrce_dds_client/dds_topics.yaml        | 1 +
 src/modules/uxrce_dds_client/generate_dds_topics.py | 9 +++++++++
 src/modules/uxrce_dds_client/utilities.hpp          | 4 ++--
 src/modules/uxrce_dds_client/uxrce_dds_client.cpp   | 1 +
 5 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/src/modules/uxrce_dds_client/dds_topics.h.em b/src/modules/uxrce_dds_client/dds_topics.h.em
index d3dc791492..b53309c662 100644
--- a/src/modules/uxrce_dds_client/dds_topics.h.em
+++ b/src/modules/uxrce_dds_client/dds_topics.h.em
@@ -157,7 +157,7 @@ bool RcvTopicsPubs::init(uxrSession *session, uxrStreamId reliable_out_stream_id
 @[    for idx, sub in enumerate(subscriptions)]@
 	{
 			uint16_t queue_depth = uORB::DefaultQueueSize<@(sub['simple_base_type'])_s>::value * 2; // use a bit larger queue size than internal
-			create_data_reader(session, reliable_out_stream_id, best_effort_in_stream_id, participant_id, @(idx), client_namespace, "@(sub['topic_simple'])", "@(sub['dds_type'])", queue_depth);
+			create_data_reader(session, reliable_out_stream_id, @('reliable_in_stream_id' if sub['reliable'] else 'best_effort_in_stream_id'), participant_id, @(idx), client_namespace, "@(sub['topic_simple'])", "@(sub['dds_type'])", queue_depth, @('true' if sub['reliable'] else 'false'));
 	}
 @[    end for]@
 
diff --git a/src/modules/uxrce_dds_client/dds_topics.yaml b/src/modules/uxrce_dds_client/dds_topics.yaml
index 26d442c9c0..a34d3932a9 100644
--- a/src/modules/uxrce_dds_client/dds_topics.yaml
+++ b/src/modules/uxrce_dds_client/dds_topics.yaml
@@ -36,6 +36,7 @@ subscriptions:
 
   - topic: /fmu/in/offboard_control_mode
     type: px4_msgs::msg::OffboardControlMode
+    reliable: true
 
   - topic: /fmu/in/onboard_computer_status
     type: px4_msgs::msg::OnboardComputerStatus
diff --git a/src/modules/uxrce_dds_client/generate_dds_topics.py b/src/modules/uxrce_dds_client/generate_dds_topics.py
index 85fa38d5b5..888b480cfe 100644
--- a/src/modules/uxrce_dds_client/generate_dds_topics.py
+++ b/src/modules/uxrce_dds_client/generate_dds_topics.py
@@ -134,6 +134,15 @@ for s in msg_map['subscriptions']:
     # topic_simple: eg vehicle_status
     s['topic_simple'] = s['topic'].split('/')[-1]
 
+    # Critical ROS 2 -> PX4 topics can opt into both reliable DDS QoS and the
+    # reliable XRCE input stream. Keep best-effort as the default.
+    reliable = s.get('reliable', False)
+    if not isinstance(reliable, bool):
+        raise ValueError(
+            f"invalid reliable {reliable!r} for {s['topic']}: expected a boolean"
+        )
+    s['reliable'] = reliable
+
 
 merged_em_globals['subscriptions'] = msg_map['subscriptions']
 
diff --git a/src/modules/uxrce_dds_client/utilities.hpp b/src/modules/uxrce_dds_client/utilities.hpp
index 91e1996fb8..93198b52d0 100644
--- a/src/modules/uxrce_dds_client/utilities.hpp
+++ b/src/modules/uxrce_dds_client/utilities.hpp
@@ -84,7 +84,7 @@ static bool create_data_writer(uxrSession *session, uxrStreamId reliable_out_str
 
 static bool create_data_reader(uxrSession *session, uxrStreamId reliable_out_stream_id, uxrStreamId input_stream_id,
 			       uxrObjectId participant_id, uint16_t index, const char *client_namespace, const char *topic_name_simple,
-			       const char *type_name, uint16_t queue_depth)
+			       const char *type_name, uint16_t queue_depth, bool reliable)
 {
 	// topic
 	char topic_name[TOPIC_NAME_SIZE];
@@ -113,7 +113,7 @@ static bool create_data_reader(uxrSession *session, uxrStreamId reliable_out_str
 
 	uxrQoS_t qos = {
 		.durability = UXR_DURABILITY_VOLATILE,
-		.reliability = UXR_RELIABILITY_BEST_EFFORT,
+		.reliability = reliable ? UXR_RELIABILITY_RELIABLE : UXR_RELIABILITY_BEST_EFFORT,
 		.history = UXR_HISTORY_KEEP_LAST,
 		.depth = queue_depth,
 	};
diff --git a/src/modules/uxrce_dds_client/uxrce_dds_client.cpp b/src/modules/uxrce_dds_client/uxrce_dds_client.cpp
index 49223e4bb7..9096376d10 100644
--- a/src/modules/uxrce_dds_client/uxrce_dds_client.cpp
+++ b/src/modules/uxrce_dds_client/uxrce_dds_client.cpp
@@ -629,6 +629,7 @@ int UxrceddsClient::print_status()
 				 (unsigned)_pubs->offboard_control_mode_gaps_over_150ms,
 				 (unsigned)_pubs->offboard_control_mode_gaps_over_250ms,
 				 (unsigned)_pubs->offboard_control_mode_gaps_over_500ms);
+			PX4_INFO("Offboard RX stream: reliable");
 
 			if (_pubs->offboard_control_mode_last_receipt != 0) {
 				PX4_INFO("Offboard RX last age: %llu us",
-- 
2.25.1

