 int UxrceddsClient::custom_command(int argc, char *argv[])
 {
+	if ((argc >= 1) && !strcmp(argv[0], "trace")) {
+		UxrceddsClient *instance = get_instance();
+
+		if (instance == nullptr) {
+			PX4_ERR("not running");
