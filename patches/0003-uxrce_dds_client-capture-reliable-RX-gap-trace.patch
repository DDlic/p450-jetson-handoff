+void UxrceddsClient::on_reliable_input_trace(uxrSession *session, const uxrReliableInputTrace *trace, void *args)
+{
+	(void)session;
+
+	if ((trace != nullptr) && (args != nullptr)) {
+		static_cast<UxrceddsClient *>(args)->record_reliable_input_trace(*trace);
+	}
+}
+
+void UxrceddsClient::record_reliable_input_trace(const uxrReliableInputTrace &trace)
+{
+	if (_reliable_trace_frozen) {
+		return;
+	}
+
+	ReliableTraceEntry &entry = _reliable_trace[_reliable_trace_head];
+	entry = {};
+	entry.receipt = hrt_absolute_time();
+	entry.seq_num = trace.seq_num;
+	entry.last_handled_before = trace.last_handled_before;
+	entry.last_handled_after = trace.last_handled_after;
+	entry.last_announced_before = trace.last_announced_before;
+	entry.last_announced_after = trace.last_announced_after;
+	entry.first_unacked_seq_num = trace.first_unacked_seq_num;
+	entry.nack_bitmap = trace.nack_bitmap;
+	entry.event = static_cast<uint8_t>(trace.event);
+	entry.stream_id = trace.stream_id;
+	entry.message_stored = trace.message_stored;
+	entry.ready_to_read = trace.ready_to_read;
+
+	if (_pubs != nullptr) {
+		entry.offboard_count = _pubs->offboard_control_mode_received;
+		entry.offboard_receipt = _pubs->offboard_control_mode_last_receipt;
+		entry.offboard_timestamp = _pubs->offboard_control_mode_last_timestamp;
+
+		if (_pubs->offboard_control_mode_trace_gap_us != 0) {
+			entry.offboard_gap_us = _pubs->offboard_control_mode_trace_gap_us;
+			entry.offboard_receipt = _pubs->offboard_control_mode_trace_receipt;
+			entry.offboard_timestamp = _pubs->offboard_control_mode_trace_timestamp;
+			_reliable_trace_trigger_gap_us = entry.offboard_gap_us;
+			_pubs->offboard_control_mode_trace_gap_us = 0;
+			_pubs->offboard_control_mode_trace_receipt = 0;
+			_pubs->offboard_control_mode_trace_timestamp = 0;
+		}
+	}
+
+	_reliable_trace_head = (_reliable_trace_head + 1) % RELIABLE_TRACE_CAPACITY;
+
+	if (_reliable_trace_count < RELIABLE_TRACE_CAPACITY) {
+		_reliable_trace_count++;
+	}
+
+	if (_reliable_trace_trigger_gap_us != 0) {
+		_reliable_trace_frozen = true;
+	}
+}
+
+void UxrceddsClient::reset_reliable_input_trace()
+{
+	_reliable_trace_head = 0;
+	_reliable_trace_count = 0;
+	_reliable_trace_frozen = false;
+	_reliable_trace_trigger_gap_us = 0;
+
+	if (_pubs != nullptr) {
+		_pubs->offboard_control_mode_trace_gap_us = 0;
+		_pubs->offboard_control_mode_trace_receipt = 0;
+		_pubs->offboard_control_mode_trace_timestamp = 0;
+	}
+}
+
+void UxrceddsClient::dump_reliable_input_trace() const
+{
+	PX4_INFO("RXTRACE summary,count=%u,frozen=%u,trigger_gap_us=%u",
+		 (unsigned)_reliable_trace_count, (unsigned)_reliable_trace_frozen,
+		 (unsigned)_reliable_trace_trigger_gap_us);
+	PX4_INFO("RXTRACE columns,i,event,t_us,stream,seq,handled_before,handled_after,announced_before,announced_after,stored,ready,first_unacked,nack_bitmap,offboard_count,offboard_gap_us,offboard_receipt_us,offboard_timestamp");
+
+	const uint16_t first = (_reliable_trace_head + RELIABLE_TRACE_CAPACITY - _reliable_trace_count)
+			       % RELIABLE_TRACE_CAPACITY;
+
+	for (uint16_t i = 0; i < _reliable_trace_count; ++i) {
+		const ReliableTraceEntry &entry = _reliable_trace[(first + i) % RELIABLE_TRACE_CAPACITY];
+		PX4_INFO("RXTRACE,%u,%u,%llu,%u,%u,%u,%u,%u,%u,%u,%u,%u,0x%04x,%u,%u,%llu,%llu",
+			 (unsigned)i, (unsigned)entry.event, (unsigned long long)entry.receipt,
+			 (unsigned)entry.stream_id, (unsigned)entry.seq_num,
+			 (unsigned)entry.last_handled_before, (unsigned)entry.last_handled_after,
+			 (unsigned)entry.last_announced_before, (unsigned)entry.last_announced_after,
+			 (unsigned)entry.message_stored, (unsigned)entry.ready_to_read,
+			 (unsigned)entry.first_unacked_seq_num, (unsigned)entry.nack_bitmap,
+			 (unsigned)entry.offboard_count, (unsigned)entry.offboard_gap_us,
+			 (unsigned long long)entry.offboard_receipt,
+			 (unsigned long long)entry.offboard_timestamp);
+	}
+}
